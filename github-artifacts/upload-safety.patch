+def artifact_path(name):
+    root = Path(app.config['UPLOAD_FOLDER']).resolve(strict=True)
+    if not name or name in ('.', '..') or '/' in name or '\\' in name:
+        abort(400)
+    path = root / name
+    if path.is_symlink() or path.resolve(strict=False).parent != root:
+        abort(400)
+    return path
